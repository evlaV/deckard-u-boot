CONFIG_DEBUG_UART=y
CONFIG_DEBUG_UART_ANNOUNCE=y
CONFIG_DEBUG_UART_BASE=0x89c000
CONFIG_DEBUG_UART_MSM_GENI=y
CONFIG_DEBUG_UART_CLOCK=14745600
# Debug fragment for the SM8650 HDK hypervisor build, merged onto
# qcom_sm8650_defconfig: the board's serial, machine and DTB bits come from
# there, this file only adds the early-console, EL2-spy and command extras.
#
# Early console: DEBUG_UART drives the Geni-QUP console directly, before the
# driver-model serial driver is up, so early boot and EL2 faults always print.
#
# Hypervisor bit: HYP_SPY_RPMH (the EL2 RPMH spy) is left OFF, so the RPMH RSC
# is passed through to the guest untouched.  Runs 92-99 are the reason: a
# paravirtualised RSC either starves the guest's own driver (masking its
# DRV_IRQ_ENABLE makes the hardware status unreadable, so tcs_tx_done()
# reclaims nothing and rpmh_rsc_send_data() waits forever for a free TCS) or
# still lets the guest's votes reach the AOP, which resets the board.  The spy
# code stays in the tree behind this Kconfig; scripts/RPMH_SPY.md records what
# was measured.
#
# Commands left on for interactive use at the shell.  The old autoboot demo
# sequence is gone - the board test suite now runs in C (hyp/test.c) - so these
# are only for poking at the hypervisor by hand:
#  - hvc       - issue Hypervisor Calls (cmd/smccc.c); `hvc hello` exercises
#                the smccc hello special-case (HV_ECHO_STR).
#  - regulator - re-vote a DT regulator (e.g. vreg_bob1) so the EL2 spy traps
#                a full voltage vote.
#  - vgic      - guest-side (EL1) view of the virtual GIC CPU interface
#                (dev/VGIC.md).
#  - hypsmp    - PSCI/secondary-core queries and the hypervisor's vCPU table
#                (dev/SMP.md).
CONFIG_CMD_HVC=y
CONFIG_CMD_HYPSMP=y
CONFIG_CMD_REGULATOR=y
CONFIG_CMD_VGIC=y
# Fastboot download buffer: big enough for the full mkosi UKI (~265 MB);
# the address itself comes from $fastboot_addr_r in default.env.
CONFIG_FASTBOOT_BUF_SIZE=0x14000000
# The OS's device tree grows at boot: the HDK display card overlay (applied by
# hyp-usb.c) and the hypervisor's virtual devices.  The EFI DT fixup protocol
# hands over strings + this much slack.
CONFIG_SYS_FDT_PAD=0x20000
