# Configuration for building U-Boot to be flashed
# to the uefi partition of QCM6490 dev boards with
# the "Linux Embedded" partition layout (which have
# a dedicated "uefi" partition for edk2/U-Boot)

#include "qcom_defconfig"

# Otherwise buildman thinks this isn't an ARM platform
CONFIG_ARM=y

CONFIG_CLK_CCF_FULL=y

# Address where U-Boot will be loaded
CONFIG_TEXT_BASE=0xa7000000
CONFIG_QCOM_GENERATE_MBN=y

CONFIG_VIDEO_BRIDGE=y
CONFIG_VIDEO_QCOM=y
CONFIG_VIDEO_MIPI_DSI=y
CONFIG_PHY_QCOM_MIPI_DSI=y
CONFIG_VIDEO_LCD_VISIONOX_VTDR6130=y
CONFIG_QCOM_POWER_DOMAIN=y

CONFIG_VIDEO_BMP_GZIP=y
CONFIG_BMP_32BPP=y

CONFIG_CMD_BIND=y
CONFIG_SKIP_EARLY_DM=y

CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8650-ayaneo-pocket-s2"
