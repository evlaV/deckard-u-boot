# Configuration for U-Boot on the Valve Steam Frame

#include "qcom_defconfig"

# Otherwise buildman thinks this isn't an ARM platform
CONFIG_ARM=y

CONFIG_LOGLEVEL=8
CONFIG_LOG_DEFAULT_LEVEL=6

CONFIG_CLK_CCF_FULL=y

# boot LUN GPT only has 32 entries
CONFIG_EFI_PARTITION_ENTRIES_NUMBERS=32

# Address where U-Boot will be loaded
CONFIG_TEXT_BASE=0xa7000000
CONFIG_QCOM_GENERATE_MBN=y

CONFIG_QCOM_SCM=y

CONFIG_VIDEO_BRIDGE=y
CONFIG_VIDEO_QCOM=y
CONFIG_VIDEO_MIPI_DSI=y
CONFIG_PHY_QCOM_MIPI_DSI=y
CONFIG_QCOM_POWER_DOMAIN=y
CONFIG_CONSOLE_ROTATION=y

CONFIG_DM_REGULATOR_MPQ3367=y
CONFIG_DM_REGULATOR_MP3317=y
CONFIG_DM_REGULATOR_NEX10001UB=y
CONFIG_DM_REGULATOR_TPS61377=y

CONFIG_VIDEO_LCD_DECKARD_PANEL=y

CONFIG_VIDEO_BMP_GZIP=y
CONFIG_BMP_32BPP=y

CONFIG_CMD_BIND=y
CONFIG_SKIP_EARLY_DM=y

CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8650-valve-deckard"
